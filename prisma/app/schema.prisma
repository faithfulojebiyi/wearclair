// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider               = "prisma-client"
  output                 = "../../orm/app"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

generator json {
  provider     = "prisma-json-types-generator"
  namespace    = "PrismaJson"
  clientOutput = "../../orm/app"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth — OWNED BY BETTER AUTH (plain user sessions; consumer product, no orgs).
// Generated by `@better-auth/cli generate` from libs/system/auth/auth.ts. Prisma
// MODEL + FIELD names are kept exactly as Better Auth expects (`User`, `Session`,
// `emailVerified`, …); @@map/@map give the DB snake_case names (wearclair convention).
// If the CLI is re-run it emits singular/camelCase defaults — re-apply @@map/@map.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]
  devices       Device[]
  dailyInsights DailyInsight[]

  @@unique([email])
  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Wearable domain — relational tier only. Raw biomarker samples live in the
// SEPARATE time-series database (TimescaleDB, timeseries/migrations/*.sql, accessed
// via @system/timeseries) — never modeled here. Rows that derive from raw windows
// carry lineage columns (source_from/source_to/source_sample_count) by value; there
// are no cross-database foreign keys.
// ─────────────────────────────────────────────────────────────────────────────

enum CyclePhase {
  MENSTRUAL
  FOLLICULAR
  OVULATORY
  LUTEAL

  @@map("cycle_phase")
}

enum SyncBatchStatus {
  RECEIVED
  PROCESSED

  @@map("sync_batch_status")
}

model Device {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  model        String      @default("clair-band-01")
  lastSyncedAt DateTime?   @map("last_synced_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  syncBatches  SyncBatch[]

  @@index([userId])
  @@map("devices")
}

model SyncBatch {
  id          String          @id @default(uuid())
  deviceId    String          @map("device_id")
  device      Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  // denormalized so batch queries don't join through devices
  userId      String          @map("user_id")
  windowStart DateTime        @map("window_start")
  windowEnd   DateTime        @map("window_end")
  sampleCount Int             @map("sample_count")
  status      SyncBatchStatus @default(RECEIVED)
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("sync_batches")
}

model DailyInsight {
  id                String     @id @default(uuid())
  userId            String     @map("user_id")
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime   @db.Date
  cycleDay          Int        @map("cycle_day")
  phase             CyclePhase
  basalTempC        Float      @map("basal_temp_c")
  restingHrBpm      Float      @map("resting_hr_bpm")
  hrvRmssdMs        Float      @map("hrv_rmssd_ms")
  // 0-100 composite vs the user's rolling baseline
  readiness         Int
  // lineage: the raw tsdb window this row was derived from (cross-db, by value)
  sourceFrom        DateTime   @map("source_from")
  sourceTo          DateTime   @map("source_to")
  sourceSampleCount Int        @map("source_sample_count")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@map("daily_insights")
}


