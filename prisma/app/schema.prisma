// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider               = "prisma-client"
  output                 = "../../orm/app"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

generator json {
  provider     = "prisma-json-types-generator"
  namespace    = "PrismaJson"
  clientOutput = "../../orm/app"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth — OWNED BY BETTER AUTH (plain user sessions; consumer product, no orgs).
// Generated by `@better-auth/cli generate` from libs/system/auth/auth.ts. Prisma
// MODEL + FIELD names are kept exactly as Better Auth expects (`User`, `Session`,
// `emailVerified`, …); @@map/@map give the DB snake_case names (wearclair convention).
// If the CLI is re-run it emits singular/camelCase defaults — re-apply @@map/@map.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  sessions       Session[]
  accounts       Account[]
  devices        Device[]
  dailyInsights  DailyInsight[]
  cycleLogs      CycleLog[]
  healthInsights HealthInsight[]

  @@unique([email])
  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Wearable domain — relational tier only. Raw biomarker samples live in the
// SEPARATE time-series database (TimescaleDB, timeseries/migrations/*.sql, accessed
// via @system/timeseries) — never modeled here. Rows that derive from raw windows
// carry lineage columns (source_from/source_to/source_sample_count) by value; there
// are no cross-database foreign keys.
// ─────────────────────────────────────────────────────────────────────────────

model Device {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  model        String      @default("clair-band-01")
  lastSyncedAt DateTime?   @map("last_synced_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  syncBatches  SyncBatch[]

  @@index([userId])
  @@map("devices")
}

model SyncBatch {
  id          String          @id @default(uuid())
  deviceId    String          @map("device_id")
  device      Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  // denormalized so batch queries don't join through devices
  userId      String          @map("user_id")
  // client-supplied idempotency key — retries of the same client batch reuse the
  // row (and the deterministic event id) instead of minting a duplicate
  clientBatchId   String?     @map("client_batch_id")
  windowStart DateTime        @map("window_start")
  windowEnd   DateTime        @map("window_end")
  sampleCount Int             @map("sample_count")
  // ingest lifecycle: RECEIVED → RAW_WRITTEN → PUBLISHED → PROCESSED (FAILED = raw
  // write failed). plain string validated by zod (SyncBatchStatusSchema) at the
  // boundary — not a db enum, so changing the set never needs an ALTER TYPE migration.
  // RAW_WRITTEN rows older than the republish window are swept by the recovery cron.
  status      String          @default("RECEIVED")
  // lifecycle timestamps + publish attempts, for the recovery cron and ops queries
  rawWrittenAt    DateTime?   @map("raw_written_at")
  publishedAt     DateTime?   @map("published_at")
  processedAt     DateTime?   @map("processed_at")
  publishAttempts Int         @default(0) @map("publish_attempts")
  // when the recovery cron may next (re)publish this batch — persisted so the
  // sweep queries due-ness directly instead of paging + filtering (no starvation)
  nextPublishAttemptAt DateTime? @map("next_publish_attempt_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@unique([deviceId, clientBatchId])
  @@index([userId, createdAt])
  // recovery cron scans by status + due time
  @@index([status, nextPublishAttemptAt])
  @@map("sync_batches")
}

model DailyInsight {
  id                String     @id @default(uuid())
  userId            String     @map("user_id")
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime   @db.Date
  cycleDay          Int        @map("cycle_day")
  // plain string validated by zod (CyclePhaseSchema) at the boundary — not a db enum,
  // so changing the phase set never needs an ALTER TYPE migration
  phase             String
  basalTempC        Float      @map("basal_temp_c")
  restingHrBpm      Float      @map("resting_hr_bpm")
  hrvRmssdMs        Float      @map("hrv_rmssd_ms")
  // 0-100 composite vs the user's rolling baseline
  readiness         Int
  // estimated hormone concentrations (sensor-fusion model output), decoded from the
  // multi-system physiological signature for the cycle day
  estradiolPgMl     Float      @map("estradiol_pg_ml")
  progesteroneNgMl  Float      @map("progesterone_ng_ml")
  lhMiuMl           Float      @map("lh_miu_ml")
  fshMiuMl          Float      @map("fsh_miu_ml")
  // lineage: the raw tsdb window this row was derived from (cross-db, by value)
  sourceFrom        DateTime   @map("source_from")
  sourceTo          DateTime   @map("source_to")
  sourceSampleCount Int        @map("source_sample_count")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  // change-gate state for the AI card feed: hash of the day's rounded values at last
  // generation, plus when they were generated. written by refresh-health-insights only,
  // disjoint from the columns compute-daily-insights writes (row-lock safe).
  insightSignature    String?   @map("insight_signature")
  insightsGeneratedAt DateTime? @map("insights_generated_at")

  @@unique([userId, date])
  @@map("daily_insights")
}

// user-logged cycle events — the app's Quick Actions (period / symptom / mood).
// `type` is a plain string, NOT a db enum: the allowed set is validated by a zod
// schema at the API boundary (cycleLogTypeSchema), so adding a category is a one-line
// schema change, not an `ALTER TYPE` migration.
model CycleLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // the calendar day this entry belongs to (@db.Date, no time) — distinct from the
  // loggedAt audit timestamp. one row per (user, day, category) via the unique below.
  date      DateTime @default(now()) @db.Date @map("log_date")
  loggedAt  DateTime @default(now()) @map("logged_at")
  type      String
  // e.g. "heavy" / "cramps" / "energetic" — free-form label per type
  value     String
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, date, type])
  @@index([userId, loggedAt])
  @@map("cycle_logs")
}

// worker-generated health insights (the Insights feed). Produced per day from the
// derived DailyInsight by the AI SDK (rule-engine fallback). `category` and `priority`
// are plain strings validated by zod at the API boundary (like CycleLog.type) — adding
// a category is a schema change, not an `ALTER TYPE` migration.
model HealthInsight {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  // stable per-rule slug — the dedup dimension, so re-running the worker on the same
  // day upserts rather than duplicating (multiple insights can share a category)
  key       String
  category  String
  priority  String
  title     String
  body      String
  // optional metric callout, e.g. "estrogen 268 pg/mL"
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, date, key])
  @@index([userId, date])
  @@map("health_insights")
}


