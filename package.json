{
  "name": "wearclair",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "bun": ">=1.3.14"
  },
  "trustedDependencies": [
    "@nestjs/core",
    "@prisma/client",
    "@prisma/engines",
    "esbuild",
    "prisma"
  ],
  "scripts": {
    "prepare": "bun run prisma:generate",
    "build": "nest build api && nest build worker",
    "build:api": "nest build api",
    "build:worker": "nest build worker",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "inngest:dev": "npx --ignore-scripts=false inngest-cli@latest dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f ministack",
    "start": "nest start",
    "start:dev:api": "lsof -ti:3310 -sTCP:LISTEN | xargs kill -9 2>/dev/null; nest start api --watch",
    "start:dev:worker": "lsof -ti:3311 -sTCP:LISTEN | xargs kill -9 2>/dev/null; nest start worker --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod:api": "node dist/apps/api/main",
    "start:prod:worker": "node dist/apps/worker/main",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "lint:check": "eslint \"{apps,libs}/**/*.ts\" --ignore-pattern \"libs/providers/mastra/**\"",
    "lint:mobile": "bun run --cwd mobile lint",
    "test": "bun test apps libs timeseries",
    "test:core": "bun test apps libs timeseries --path-ignore-patterns=libs/providers/mastra",
    "test:watch": "bun test --watch apps libs timeseries",
    "test:cov": "bun test --coverage apps libs timeseries",
    "typecheck:mobile": "bun run --cwd mobile typecheck",
    "check:core": "bun run lint:check && bun run test:core && bun run build && bun run lint:mobile && bun run typecheck:mobile",
    "prisma:generate": "bunx prisma generate --schema prisma/app/schema.prisma",
    "prisma:migrate:app": "bunx prisma migrate dev --schema prisma/app/schema.prisma",
    "prisma:reset:app": "bunx prisma migrate reset --schema prisma/app/schema.prisma",
    "prisma:status:app": "bunx prisma migrate status --schema prisma/app/schema.prisma",
    "prisma:deploy": "bunx prisma migrate deploy --schema prisma/app/schema.prisma",
    "db:reset:mastra": "bun --env-file=apps/api/.env prisma/reset-mastra.ts",
    "db:reset:all": "bun run prisma:reset:app && bun run db:reset:mastra && bun run tsdb:reset",
    "tsdb:migrate": "bun --env-file=apps/api/.env timeseries/migrate.ts",
    "tsdb:reset": "bun --env-file=apps/api/.env timeseries/reset.ts && bun run tsdb:migrate",
    "tsdb:generate": "bun timeseries/generate.ts",
    "seed:demo": "bun --env-file=apps/api/.env timeseries/seed-demo.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
    "@aws-sdk/client-s3": "^3.964.0",
    "@aws-sdk/lib-storage": "^3.964.0",
    "@aws-sdk/s3-presigned-post": "^3.964.0",
    "@aws-sdk/s3-request-presigner": "^3.964.0",
    "@better-auth/expo": "^1.6.23",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@keyv/valkey": "^1.0.11",
    "@mastra/core": "1.49.0",
    "@mastra/memory": "1.22.1",
    "@mastra/pg": "1.15.0",
    "@mastra/server": "1.49.0",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-fastify": "^11.1.21",
    "@nestjs/swagger": "11.4.3",
    "@nestjs/terminus": "^11.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/extension-read-replicas": "^0.5.0",
    "@storagesdk/adapters": "^0.8.0",
    "@storagesdk/core": "^0.4.2",
    "@timescaledb/core": "0.0.1",
    "ai": "^7.0.31",
    "better-auth": "^1.6.23",
    "cache-manager": "^7.2.7",
    "fastify": "5.8.5",
    "inngest": "4.7.0",
    "joi": "^18.0.2",
    "keyv": "^5.5.5",
    "lexorank": "^1.0.5",
    "mammoth": "^1.9.0",
    "nestjs-cls": "^6.2.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "5.3.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.6.0",
    "rxjs": "^7.8.1",
    "uuid": "^13.0.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.2.2",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.0.0",
    "mastra": "^1.15.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "prisma-json-types-generator": "^5.0.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
