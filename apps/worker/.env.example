# worker (background jobs) — copy to apps/worker/.env and fill in. Secrets shown as <...> placeholders.

PORT=3311
NODE_ENV=development
APP_ENV=development
# API_PREFIX=/

# database (postgres — the tsdb compose container on 6543 hosts all three DBs)
APP_DATABASE_URL=postgresql://postgres:postgres@localhost:6543/wearclair
# APP_DATABASE_REPLICA_URL=postgresql://postgres:postgres@localhost:6543/wearclair

# mastra agent runtime — its OWN database (never Prisma-managed; tables created on boot)
MASTRA_DATABASE_URL=postgresql://postgres:postgres@localhost:6543/wearclair_mastra

# time-series database (TimescaleDB — raw pg via BiomarkerStore, never Prisma-managed)
TSDB_DATABASE_URL=postgresql://postgres:postgres@localhost:6543/wearclair_tsdb

# llm (Mastra model router)
# ANTHROPIC_API_KEY=<anthropic-api-key>

# redis cache (valkey) — optional in dev
# APP_REDIS_URL=rediss://localhost:6379

# inngest (cloud) — required in prod; dev uses INNGEST_DEV=1 below
# INNGEST_SIGNING_KEY=<inngest-signing-key>
# INNGEST_EVENT_KEY=<inngest-event-key>
INNGEST_DEV=1

# resend (email)
# RESEND_API_KEY=<resend-api-key>

# storage (StorageSDK) — local dev = ministack emulator: bun run infra:up
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
S3_BUCKET=wearclair-uploads
S3_ENDPOINT=http://127.0.0.1:4567
S3_FORCE_PATH_STYLE=true

# LOG_LEVEL=info
